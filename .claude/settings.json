{
  "permissions": {
    "deny": ["Edit(/src/routeTree.gen.ts)", "Edit(/src/lib/api.gen.ts)", "Edit(/bun.lock)"]
    // "ask": [
    //   "Edit(/oxlint.config.ts)",
    //   "Edit(/oxfmt.config.ts)",
    //   "Edit(/doctor.config.ts)",
    //   "Edit(/vite.config.ts)",
    //   "Edit(/playwright.config.ts)",
    //   "Edit(/tsconfig*.json)",
    //   "Edit(/.claude/**)"
    // ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-changed.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh",
            "timeout": 300,
            "statusMessage": "Running bun run check"
          }
        ]
      }
    ]
  }
}
