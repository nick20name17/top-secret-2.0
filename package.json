{
  "name": "spa-2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "test": "vitest",
    "e2e": "playwright test",
    "ui:add": "sh -c 'yes n | shadcn add --yes \"$@\" && oxfmt src/components/ui && oxlint src/components/ui' --",
    "api:types": "bun --env-file=.env exec 'bunx openapi-typescript@7.13.0 $VITE_API_URL/openapi.json -o src/lib/api.gen.ts'",
    "routes": "bun --bun tsr generate",
    "typecheck": "bun run routes && tsc -b",
    "doctor": "react-doctor --no-telemetry",
    "audit": "bun audit --audit-level=high",
    "check": "bun run routes && bun run format:check && bun run lint && tsc -b && bun run doctor --blocking warning && vitest run",
    "verify": "bun run check && bun run audit && bun run e2e"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.3",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "ky": "2.2.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@playwright/cli": "0.1.23",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@shadcn/lint": "0.2.5",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-playwright": "2.12.2",
    "msw": "3.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.0",
    "react-doctor": "0.9.22",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "react-doctor@0.9.22": "patches/react-doctor@0.9.22.patch"
  },
  "trustedDependencies": []
}
