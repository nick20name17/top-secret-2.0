{
  "name": "spa-2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "e2e": "playwright test",
    "ui:add": "yes n | shadcn add --yes",
    "api:types": "bun --env-file=.env exec 'bunx openapi-typescript@7.13.0 $VITE_API_URL/openapi.json -o src/lib/api.gen.ts'",
    "typecheck": "bun --bun tsr generate && tsc -b",
    "doctor": "bash -o pipefail -c 'react-doctor --no-telemetry | sed \"/^Agent guidance/,/^ *$/d\"'",
    "audit": "bun audit --audit-level=high",
    "check": "bun run --sequential typecheck format:check lint doctor test",
    "verify": "bun run --sequential check audit e2e"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.7",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "ky": "2.2.0",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@playwright/cli": "0.1.24",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@shadcn/lint": "0.2.5",
    "@tanstack/eslint-plugin-query": "5.108.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-playwright": "2.12.2",
    "msw": "3.0.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-plugin-eslint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "playwright": "1.65.1",
    "react-doctor": "0.9.23",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
